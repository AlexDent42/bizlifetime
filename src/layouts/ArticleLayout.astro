---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
const { title, description, pubDate, updatedDate, category, image, imageAlt } = article.data;
const dateLabel = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={`${title} | BizLifetime`} description={description} image={image}>
	<article class="article-page">
		<header class="article-header">
			<a class="back-link" href="/">← All articles</a>
			<p class="eyebrow">{category}</p>
			<h1>{title}</h1>
			<p class="article-deck">{description}</p>
			<p class="article-byline"><time datetime={pubDate.toISOString()}>{dateLabel}</time>{updatedDate && <span> · Updated {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>}</p>
		</header>
		<img class="article-hero" src={image} alt={imageAlt} width="1200" height="675" fetchpriority="high" />
		<div class="prose"><slot /></div>
		<nav class="article-end" aria-label="Article navigation"><a href="/">← Browse more articles</a></nav>
	</article>
</BaseLayout>
